# Copy this file to ".env" and fill in the values.
# These match the outputs written by lab513/scripts/deploy.sh into lab513/.env.

SQL_FQDN=faq-ai-assistant-<LAB_INSTANCE_ID>.database.windows.net
SQL_DB=faq-ai-assistant-db
SQL_ADMIN=admin-<LAB_INSTANCE_ID>
SQL_PASSWORD=

# ODBC driver name as registered on this machine (Windows + Linux both use 18).
ODBC_DRIVER=ODBC Driver 18 for SQL Server
